# Contact form endpoint (e.g. a Formspree form URL). Leave empty to fall back to a mailto: link.
# If you use a different provider, also add its origin to connect-src / form-action in vercel.json and public/_headers.
VITE_FORM_ENDPOINT=
VITE_CONTACT_EMAIL=hello@retrovante.com

# Public origin used by canonical URLs, sitemap and share previews.
VITE_SITE_URL=https://retrovante.com
